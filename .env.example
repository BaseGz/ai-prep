# 复制成 .env 后填真实值。.env 已在 .gitignore 里，永不入库。
#
# D1 只需要 DEEPSEEK_API_KEY 有值，其余可以先留空。
# 键名与 .env 保持一致，改了一个记得同步另一个。

# —— 主力模型：DeepSeek（走 OpenAI 兼容协议）——
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# —— 备用供应商：D2「一键切供应商」对比时用 ——
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# —— 可观测：D28 trace 与成本核算时才开 ——
# 填了 key 再把它改成 true；留空但写 true 会让 langsmith 不停报 401
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
